{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 145",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:all": "playwright test",
    "audit:prod": "npm audit --omit=dev",
    "smoke:golive": "node scripts/golive-smoke-check.mjs",
    "gen:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.460.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "serialize-javascript": "^7.0.5"
  }
}
