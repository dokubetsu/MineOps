# See docs/ENV.md for full documentation.

# Supabase Public Configuration (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY (admin/platform routes, E2E seed)
# Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Platform first-time bootstrap (/platform/setup)
# REQUIRED in production until the first platform_owner exists (Phase A).
# After bootstrap succeeds: rotate or delete this value.
# Generate e.g.: openssl rand -hex 32
# PLATFORM_BOOTSTRAP_SECRET=

# Playwright — local/CI only. Never use these passwords in production.
# E2E_ADMIN_EMAIL=admin@khani.com
# E2E_ADMIN_PASSWORD=password123

# Durable rate limit (Phase E5 / Phase 2) — server only
# Strongly recommended in production (multi-instance). Without these,
# limits are in-memory per isolate and a warning is logged.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
