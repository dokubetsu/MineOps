# See docs/ENV.md for full documentation.

# Supabase Public Configuration (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY (admin/platform routes, E2E seed)
# Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Optional: required when bootstrapping the first platform_owner via /platform/setup
# PLATFORM_BOOTSTRAP_SECRET=

# Optional: Playwright overrides
# E2E_ADMIN_EMAIL=admin@mineops.com
# E2E_ADMIN_PASSWORD=password123
